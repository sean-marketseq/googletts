# OpenAI API Configuration
OPENAI_API_KEY=sk-...

# 2026 Model Configuration - Latest GPT Models
# Extraction: gpt-5-mini (fast, efficient, much smarter than gpt-4o-mini)
# Synthesis: gpt-5.4 (latest frontier model)
# Master Analysis: o3-deep-research (deep research mode for pattern analysis)
# Transcription: whisper-1 (proven, reliable)
# Embeddings: text-embedding-3-small (efficient, 1024 dimensions)

OPENAI_EXTRACTION_MODEL=gpt-5-mini
OPENAI_SYNTHESIS_MODEL=gpt-5.4
OPENAI_MASTER_ANALYSIS_MODEL=o3-deep-research
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone Configuration
PINECONE_API_KEY=...
PINECONE_INDEX=conversations
PINECONE_ENVIRONMENT=us-east-1-aws
